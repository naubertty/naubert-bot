# Copie este arquivo para .env e preencha os valores.
# O .env nunca é servido pela página nem versionado.

# Obrigatório: sua chave da API da Anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Porta do servidor local.
PORT=8787

# Interface de escuta. 0.0.0.0 permite abrir de outro dispositivo da rede.
HOST=0.0.0.0

# Opcional: exige o header x-proxy-token em /api/messages.
# Útil se você expõe o servidor para fora de localhost.
# PROXY_TOKEN=

# Opcional: origens extras liberadas para CORS, separadas por vírgula.
# localhost, 127.0.0.1 e *.e2b.app já são liberados automaticamente.
# ALLOWED_ORIGINS=https://meu-dominio.com

# Opcional: limite de requisições por minuto, por IP.
# RATE_MAX=90

# Opcional: tempo máximo de espera da API, em milissegundos.
# UPSTREAM_TIMEOUT=180000
