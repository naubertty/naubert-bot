# Copie este arquivo para .env e preencha os valores.
# O .env nunca é servido pela página nem versionado.

# ---------------------------------------------------------------- OpenRouter
# Recomendado: uma chave dá acesso a Claude, GPT, Gemini e outros.
# Crie em https://openrouter.ai/workspaces/default/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Opcional: identificação do app nos headers do OpenRouter.
# OPENROUTER_REFERER=https://seu-site
# OPENROUTER_TITLE=naubert-bot

# ---------------------------------------------------------------- Anthropic
# Opcional: só se você for usar o provedor "Anthropic (direto)".
# ANTHROPIC_API_KEY=sk-ant-...

# ----------------------------------------------------------------- servidor
PORT=8787
HOST=0.0.0.0

# Opcional: exige o header x-proxy-token em /api/messages e /api/openrouter/*.
# PROXY_TOKEN=

# Opcional: origens extras liberadas para CORS, separadas por vírgula.
# ALLOWED_ORIGINS=https://meu-dominio.com

# Opcional: limite de requisições por minuto, por IP.
# RATE_MAX=90

# Opcional: tempo máximo de espera das APIs, em milissegundos.
# UPSTREAM_TIMEOUT=180000
